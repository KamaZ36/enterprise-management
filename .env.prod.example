# Продакшн-настройки. Скопируйте в .env.prod и заполните.
# Файл не коммитится: chmod 600 .env.prod

DEBUG=False
LOG_LEVEL=INFO
LOG_JSON=True
LOG_ACCESS=True
SQL_ECHO=False

# --- База данных (внутренняя сеть compose, наружу порт не публикуется) ---
DB_USER=md
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=myasnaya_derevnya

# --- Первый администратор ---
# Пароль обязательно смените после первого входа.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_ROLE_CODE=SUPER_ADMIN
ADMIN_ROLE_NAME="Технический администратор"

# --- Подпись кодов входа (минимум 16 символов) ---
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LOGIN_CODE_SECRET=CHANGE_ME_LOGIN_CODE_SECRET

# --- Медиа: файлы лежат в volume, в БД только ссылки ---
MEDIA_ROOT=media
MEDIA_URL_PREFIX=/media
MEDIA_MAX_BYTES=8388608
MEDIA_MAX_SIDE=1600
MEDIA_WEBP_QUALITY=82

# --- Домены. DNS A-записи всех четырёх имён должны указывать на сервер. ---
LANDING_HOST=example.com
ADMIN_HOST=admin.example.com
CAFE_HOST=cafe.example.com
API_HOST=api.example.com

# Адреса для ссылок между витринами. Вшиваются в статику при сборке.
NUXT_PUBLIC_LANDING_URL=https://example.com
NUXT_PUBLIC_CAFE_APP_URL=https://cafe.example.com

# Браузерные источники. При работе через один и тот же домен CORS не нужен,
# но список безопасно держать заполненным.
CORS_ORIGINS=["https://example.com","https://admin.example.com","https://cafe.example.com"]

# --- ОФД (можно оставить пустым: приложение работает без синхронизации) ---
OFD_API_URL=https://ofd.ru/api/integration/v2
OFD_API_TOKEN=
OFD_INN=
OFD_TIMEZONE=Europe/Moscow
OFD_REQUEST_TIMEOUT=30
# OFD_CUTOVER_DATE=2026-11-01

# --- Прочее ---
COMPOSE_PROJECT_NAME=md
